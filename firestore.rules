rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // القاعدة الأساسية: السماح بالقراءة والكتابة فقط للمستخدمين المسجلين (كما طلبت)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // ----------------------------------------------------------------------------------
    // ملاحظة للمطور (Super Admin):
    // القواعد أعلاه تسمح لأي مستخدم مسجل بالوصول لكل البيانات.
    // لتطبيق "فصل البيانات" (Tenant Isolation) بشكل آمن 100% على السيرفر،
    // يجب تعديل القواعد مستقبلاً لتصبح كالتالي (كمثال للعملاء Patients):
    //
    // match /patients/{patientId} {
    //   allow read, write: if request.auth != null && resource.data.tenantId == request.auth.uid;
    // }
    // ----------------------------------------------------------------------------------
  }
}
