{
  "applicationId": "com.shamel.erpsystem",
  "version": "1.0.0",
  "defaultMode": "window",
  "port": 0,
  "url": "/dist/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "documentRoot": "/",
  "nativeBlockList": [],
  "modes": {
    "window": {
      "title": "شامل لإدارة مراكز وفروع التجميل ERP",
      "width": 1366,
      "height": 868,
      "minWidth": 1024,
      "minHeight": 700,
      "maximize": true,
      "enableInspector": false,
      "borderless": false,
      "resizable": true
    }
  },
  "cli": {
    "binaryName": "Shamel-ERP",
    "resourcesPath": "/dist",
    "clientLibrary": "/dist/assets"
  }
}
